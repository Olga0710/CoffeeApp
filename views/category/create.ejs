<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Додати категорію</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 500px;">
    <div class="mb-3">
        <a href="/shops/<%= shop.id %>/categories" class="btn btn-secondary btn-sm">← Назад до категорій</a>
    </div>

    <h1>➕ Нова категорія</h1>
    <p class="text-muted">Для закладу: <%= shop.name %></p>

    <form action="/shops/<%= shop.id %>/categories" method="POST" class="card p-4 shadow-sm mt-3">
        <div class="mb-3">
            <label class="form-label">Назва категорії:</label>
            <input type="text" name="name" class="form-control" placeholder="Наприклад: Кавові напої, Десерти..." required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Зберегти категорію</button>
    </form>
</body>
</html>