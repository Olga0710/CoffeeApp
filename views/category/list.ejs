<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Категорії — <%= shop.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 700px;">
    <div class="mb-3">
        <a href="/shops/<%= shop.id %>/menu" class="btn btn-secondary btn-sm">← Назад до меню</a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📁 Категорії меню: <%= shop.name %></h1>
        <a href="/shops/<%= shop.id %>/categories/create" class="btn btn-success">+ Додати категорію</a>
    </div>

    <% if (categories.length === 0) { %>
        <p class="text-muted">У цієї кав'ярні ще немає категорій. Створіть першу, щоб додавати страви!</p>
    <% } else { %>
        <ul class="list-group shadow-sm">
            <% categories.forEach(cat => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                    <span class="fs-5"><%= cat.name %></span>
                    <form action="/shops/<%= shop.id %>/categories/delete/<%= cat.id %>" method="POST" class="m-0">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Видалити категорію? Усі пов’язані позиції також можуть бути видалені!')">Видалити</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } %>
</body>
</html>