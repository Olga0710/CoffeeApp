<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= shop.name %> | Меню</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --coffee-accent: #E8A87C;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            padding-top: 90px;
            scroll-behavior: smooth;
        }

        .navbar {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        .shop-hero {
            background: linear-gradient(180deg, rgba(44, 34, 30, 0.65) 0%, rgba(44, 34, 30, 0.85) 100%), 
                        url('<%= shop.image_url || "https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb" %>') center/cover no-repeat;
            color: white;
            padding: 60px 0 50px 0;
            border-radius: 0 0 36px 36px;
            margin-bottom: 40px;
            box-shadow: 0 20px 40px rgba(44, 34, 30, 0.15);
        }

        .content-section {
            background: var(--card-bg);
            border: 1px solid rgba(200, 125, 85, 0.15);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.03);
            margin-bottom: 35px;
        }

        .category-pill {
            background-color: #FAF7F2;
            border: 1px solid rgba(200, 125, 85, 0.2);
            color: var(--coffee-dark);
            border-radius: 30px;
            padding: 8px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s;
            text-decoration: none;
        }

        .category-pill:hover, .category-pill.active {
            background-color: var(--coffee-primary);
            color: white;
            border-color: var(--coffee-primary);
        }

        .menu-item-card {
            background-color: #FAF7F2;
            border: 1px solid rgba(200, 125, 85, 0.12);
            border-radius: 18px;
            padding: 22px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            position: relative;
            cursor: pointer;
        }

        .menu-item-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(44, 34, 30, 0.08);
            background-color: #FFFFFF;
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            padding: 10px 24px;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }

        .badge-coffee {
            background-color: #F3E9E2;
            color: var(--coffee-primary);
            font-weight: 600;
            border-radius: 30px;
            padding: 6px 16px;
        }

        .badge-category-tag {
            background-color: #EFE6DE;
            color: #8C5335;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 20px;
            padding: 4px 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-item-action {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(200, 125, 85, 0.2);
            background-color: #FFFFFF;
            color: var(--coffee-dark);
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-item-action:hover {
            background-color: var(--coffee-primary);
            color: white;
            border-color: var(--coffee-primary);
        }

        .btn-item-delete:hover {
            background-color: #DC3545;
            color: white;
            border-color: #DC3545;
        }

        .modal-content {
            border-radius: 24px;
            border: none;
            background-color: var(--card-bg);
        }

        .form-control, .form-select {
            background-color: #FAF7F2;
            border: 1px solid rgba(200, 125, 85, 0.2);
            border-radius: 12px;
            padding: 10px 14px;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--coffee-primary);
            box-shadow: 0 0 0 3px rgba(200, 125, 85, 0.15);
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/shops">
                ☕ <span><%= shop.name %></span>
            </a>
            
            <div class="d-none d-lg-flex align-items-center gap-4 text-muted small fw-medium">
                <span><i class="bi bi-geo-alt-fill text-danger"></i> <%= shop.address %></span>
                <% if (shop.opening_hours) { %>
                    <span><i class="bi bi-clock-fill text-primary"></i> <%= shop.opening_hours %></span>
                <% } %>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="#menu" class="btn btn-coffee btn-sm px-3">Меню</a>
                <a href="/shops" class="btn btn-outline-dark btn-sm rounded-pill px-3" title="Назад до списку">
                    <i class="bi bi-arrow-left"></i> До списку
                </a>
            </div>
        </div>
    </nav>

    <!-- КОМПАКТНИЙ БАНЕР -->
    <header class="shop-hero text-center">
        <div class="container" style="max-width: 850px;">
            <span class="badge badge-coffee mb-2 shadow-sm">⭐ Естетична кав'ярня столиці</span>
            <h1 class="display-4 fw-bold mb-3"><%= shop.name %></h1>
            <p class="text-light opacity-90 mb-0 fs-6">
                <i class="bi bi-geo-alt-fill text-danger"></i> <%= shop.address %> &nbsp;&bull;&nbsp; 
                <% if (shop.opening_hours) { %>
                    <i class="bi bi-clock-fill text-warning"></i> <%= shop.opening_hours %>
                <% } %>
            </p>
        </div>
    </header>

    <main class="container mb-5" style="max-width: 950px;">
        
        <!-- СЕКЦІЯ МЕНЮ -->
        <section id="menu" class="content-section">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-circle" style="background: #F3E9E2; color: var(--coffee-primary);">
                        <i class="bi bi-grid-fill fs-4"></i>
                    </div>
                    <h3 class="fw-bold m-0">Категорії та асортимент</h3>
                </div>
                <div class="d-flex gap-2">
                    <a href="/shops/<%= shop.id %>/categories" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-gear-fill"></i> Управління категоріями
                    </a>
                    <button type="button" class="btn btn-coffee btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addItemModal">
                        <i class="bi bi-plus-lg"></i> Додати товар
                    </button>
                </div>
            </div>

            <!-- ФІЛЬТРАЦІЯ ЗА КАТЕГОРІЯМИ -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <a href="/shops/<%= shop.id %>/menu" class="category-pill <%= typeof currentCategory === 'undefined' || !currentCategory || currentCategory === 'all' ? 'active' : '' %>">
                    ☕ Усі товари
                </a>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                        <a href="/shops/<%= shop.id %>/menu?category=<%= cat.id %>" class="category-pill <%= (typeof currentCategory !== 'undefined' && currentCategory == cat.id) ? 'active' : '' %>">
                            <%= cat.name %>
                        </a>
                    <% }); %>
                <% } %>
            </div>

            <!-- СПИСОК ТОВАРІВ -->
            <% if (typeof menuItems === 'undefined' || menuItems.length === 0) { %>
                <div class="text-center py-5 text-muted bg-light rounded-4 border border-dashed">
                    <i class="bi bi-cup text-secondary display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold">У цій категорії поки немає товарів</h5>
                    <p class="small mb-3">Додайте позиції до асортименту закладу!</p>
                    <button type="button" class="btn btn-coffee btn-sm px-4" data-bs-toggle="modal" data-bs-target="#addItemModal">
                        <i class="bi bi-plus-lg"></i> Додати позицію
                    </button>
                </div>
            <% } else { %>
                <div class="row g-3">
                    <% menuItems.forEach(function(item) { %>
                        <div class="col-md-6">
                            <!-- Картка товару, клік по якій відкриває модальне вікно перегляду -->
                            <div class="menu-item-card h-100 d-flex flex-column justify-content-between"
                                 data-bs-toggle="modal" 
                                 data-bs-target="#itemDetailModal"
                                 data-name="<%= item.name %>"
                                 data-price="<%= item.price %>"
                                 data-description="<%= item.description || '' %>"
                                 data-image="<%= item.image_url || '' %>">
                                <div>
                                    <% if (item.image_url) { %>
                                        <div class="mb-3 overflow-hidden rounded-4" style="height: 150px;">
                                            <img src="<%= item.image_url %>" alt="<%= item.name %>" class="w-100 h-100 object-fit-cover">
                                        </div>
                                    <% } %>

                                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1"><%= item.name %></h5>
                                            <% if (typeof categories !== 'undefined') { %>
                                                <% const matchedCat = categories.find(function(c) { return c.id == item.category_id; }); %>
                                                <% if (matchedCat) { %>
                                                    <span class="badge badge-category-tag"><%= matchedCat.name %></span>
                                                <% } %>
                                            <% } %>
                                        </div>

                                        <!-- ДІЇ: РЕДАГУВАТИ ТА ВИДАЛИТИ (onclick зупиняє спливання події, щоб не відкривалось модальне вікно) -->
                                        <div class="d-flex gap-1" onclick="event.stopPropagation()">
                                            <a href="/shops/<%= shop.id %>/menu/edit/<%= item.id %>" class="btn btn-item-action" title="Редагувати товар">
                                                <i class="bi bi-pencil-fill fs-7"></i>
                                            </a>
                                            <form action="/shops/<%= shop.id %>/menu/delete/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Видалити цей товар з меню?');">
                                                <button type="submit" class="btn btn-item-action btn-item-delete" title="Видалити товар">
                                                    <i class="bi bi-trash-fill fs-7"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <% if (item.description) { %>
                                        <p class="text-muted small my-2"><%= item.description %></p>
                                    <% } %>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 mt-2 border-top">
                                    <span class="text-muted small fw-medium">Ціна</span>
                                    <span class="badge badge-coffee fs-6"><%= item.price %> грн</span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

    </main>

    <!-- МОДАЛЬНЕ ВІКНО ПЕРЕГЛЯДУ ТОВАРУ (СТИЛЬ ЯК НА СКРІНШОТІ) -->
    <div class="modal fade" id="itemDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content overflow-hidden shadow-lg" style="border-radius: 24px;">
                <!-- Червона кнопка закриття (хрестик у кутку) -->
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 bg-danger p-2 rounded-circle shadow z-3 opacity-100" data-bs-dismiss="modal" aria-label="Close"></button>
                
                <!-- Зображення товару на повну ширину зверху -->
                <div id="modalImgContainer" class="w-100 bg-light" style="height: 280px; display: none;">
                    <img id="modalImg" src="" alt="" class="w-100 h-100 object-fit-cover">
                </div>

                <div class="modal-body p-4">
                    <h3 id="modalName" class="fw-bold text-dark mb-2"></h3>
                    <h4 id="modalPrice" class="fw-bold text-danger mb-3"></h4>
                    <p id="modalDesc" class="text-muted small mb-4" style="line-height: 1.6;"></p>
                    
                    <div class="d-flex justify-content-end pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Закрити</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- МОДАЛЬНЕ ВІКНО ДОДАВАННЯ ТОВАРУ -->
    <div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-header-title fw-bold m-0" id="addItemModalLabel">☕ Новий товар у меню</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/shops/<%= shop.id %>/menu" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Назва товару:</label>
                            <input type="text" name="name" class="form-control" placeholder="Наприклад: Лате, Флєт Вайт..." required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Категорія:</label>
                            <select name="category_id" class="form-select" required>
                                <option value="" disabled selected>Оберіть категорію...</option>
                                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat.id %>"><%= cat.name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Ціна (грн):</label>
                            <input type="number" step="0.01" name="price" class="form-control" placeholder="85.00" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Опис (необов'язково):</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="Склад або смакові особливості..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Посилання на фото (URL):</label>
                            <input type="url" name="image_url" class="form-control" placeholder="https://example.com/photo.jpg">
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-coffee flex-fill">Зберегти товар</button>
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Скасувати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ФУТЕР -->
    <footer class="bg-white text-center py-4 border-top mt-5">
        <div class="container">
            <p class="mb-0 text-muted small">&copy; 2026 Zruchno Coffee News. Всі права захищені.</p>
        </div>
    </footer>

    <!-- Bootstrap JS та скрипт для модального вікна перегляду -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const itemDetailModal = document.getElementById('itemDetailModal');
            itemDetailModal.addEventListener('show.bs.modal', function (event) {
                const card = event.relatedTarget;
                
                const name = card.getAttribute('data-name');
                const price = card.getAttribute('data-price');
                const description = card.getAttribute('data-description');
                const imageUrl = card.getAttribute('data-image');

                document.getElementById('modalName').textContent = name;
                document.getElementById('modalPrice').textContent = price + ' ₴';
                
                const descEl = document.getElementById('modalDesc');
                if (description && description.trim() !== '') {
                    descEl.textContent = description;
                    descEl.style.display = 'block';
                } else {
                    descEl.style.display = 'none';
                }

                const imgContainer = document.getElementById('modalImgContainer');
                const imgEl = document.getElementById('modalImg');
                if (imageUrl && imageUrl.trim() !== '') {
                    imgEl.src = imageUrl;
                    imgContainer.style.display = 'block';
                } else {
                    imgContainer.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>