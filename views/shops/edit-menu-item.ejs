<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Редагувати позицію меню</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 600px;">
    <div class="mb-3">
        <a href="/shops/<%= shop.id %>/menu" class="btn btn-secondary btn-sm">← Назад до меню</a>
    </div>

    <h1>✏️ Редагувати: <%= item.name %></h1>
    <p class="text-muted">Кав'ярня: <%= shop.name %></p>

    <form action="/shops/<%= shop.id %>/menu/edit/<%= item.id %>" method="POST" class="mt-3 card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Назва:</label>
            <input type="text" name="name" class="form-control" value="<%= item.name %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Ціна (грн):</label>
            <input type="number" step="0.01" name="price" class="form-control" value="<%= item.price %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Опис:</label>
            <textarea name="description" class="form-control" rows="2"><%= item.description %></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Склад / Інгредієнти:</label>
            <input type="text" name="ingredients" class="form-control" value="<%= item.ingredients %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Посилання на фото (URL):</label>
            <input type="url" name="image_url" class="form-control" value="<%= item.image_url %>">
        </div>
        <button type="submit" class="btn btn-success w-100">Зберегти зміни</button>
    </form>
</body>
</html>