<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Додати кав'ярню</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 600px;">
    <h1>➕ Додати нову кав'ярню</h1>
    <form action="/shops" method="POST" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Назва кав'ярні:</label>
            <input type="text" name="name" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Адреса:</label>
            <input type="text" name="address" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Опис:</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Короткий опис закладу"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Особливості / Пропозиції:</label>
            <input type="text" name="offerings" class="form-control" placeholder="Наприклад: Кава із собою, десерти, Wi-Fi">
        </div>
        <div class="mb-3">
            <label class="form-label">Посилання на фото (URL):</label>
            <input type="url" name="image_url" class="form-control" placeholder="https://example.com/image.jpg">
        </div>
        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a href="/shops" class="btn btn-secondary">Назад</a>
    </form>
</body>
</html>