<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Меню — <%= shop.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <div class="mb-3">
        <a href="/shops" class="btn btn-secondary btn-sm">← Назад до списку кав'ярень</a>
    </div>

    <h1>☕ Меню кав'ярні: "<%= shop.name %>"</h1>
    <p class="text-muted"><%= shop.address %></p>
    <hr>

    <div class="row">
        <!-- Список позицій меню -->
        <div class="col-md-7">
            <h3>📋 Асортимент</h3>
            <% if (menuItems.length === 0) { %>
                <p class="text-muted">У цієї кав'ярні поки немає позицій у меню.</p>
            <% } else { %>
                <div class="list-group">
                    <% menuItems.forEach(item => { %>
                        <div class="list-group-item d-flex align-items-center justify-content-between mb-2 shadow-sm rounded">
                            <% if (item.image_url) { %>
                                <img src="<%= item.image_url %>" alt="Фото страви" style="width: 80px; height: 80px; object-fit: cover;" class="rounded me-3">
                            <% } %>
                            <div class="flex-grow-1 ms-2">
                                <h5 class="mb-1"><%= item.name %> — <span class="text-success"><%= item.price %> грн</span></h5>
                                <% if (item.description) { %>
                                    <p class="mb-1 text-muted small"><%= item.description %></p>
                                <% } %>
                                <% if (item.ingredients) { %>
                                    <small class="text-secondary"><strong>Склад:</strong> <%= item.ingredients %></small>
                                <% } %>
                            </div>
                            <div class="d-flex gap-2 ms-3">
                                <a href="/shops/<%= shop.id %>/menu/edit/<%= item.id %>" class="btn btn-warning btn-sm">Редагувати</a>
                                <form action="/shops/<%= shop.id %>/menu/delete/<%= item.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm">Видалити</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Форма додавання нової позиції -->
        <div class="col-md-5">
            <div class="card p-3 shadow-sm">
                <h3>➕ Додати страву / напій</h3>
                <form action="/shops/<%= shop.id %>/menu" method="POST" class="mt-3">
                    <div class="mb-3">
                        <label class="form-label">Назва:</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ціна (грн):</label>
                        <input type="number" step="0.01" name="price" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Опис:</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Короткий опис..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Склад / Інгредієнти:</label>
                        <input type="text" name="ingredients" class="form-control" placeholder="Напр. Еспресо, молоко">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Посилання на фото (URL):</label>
                        <input type="url" name="image_url" class="form-control" placeholder="https://example.com/coffee.jpg">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Додати в меню</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>