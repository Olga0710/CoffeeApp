<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Бариста | Zruchno Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            padding-top: 90px;
            padding-bottom: 40px;
        }

        .navbar {
            background-color: var(--card-bg) !important;
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        .chat-container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(44, 34, 30, 0.06);
            border: 1px solid rgba(200, 125, 85, 0.15);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            height: 72vh;
        }

        .chat-header {
            padding: 20px 25px;
            background: #FAF7F2;
            border-bottom: 1px solid rgba(200, 125, 85, 0.15);
        }

        .chat-messages {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: #ffffff;
            scroll-behavior: smooth;
        }

        /* Стилі для повідомлень */
        .message-wrapper {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            max-width: 85%;
        }

        .message-wrapper.user {
            margin-left: auto;
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .message-wrapper.bot .message-avatar {
            background-color: #F3E9E2;
            color: var(--coffee-primary);
        }

        .message-wrapper.user .message-avatar {
            background-color: var(--coffee-dark);
            color: #FAF7F2;
        }

        .message-bubble {
            padding: 12px 18px;
            border-radius: 18px;
            font-size: 0.95rem;
            line-height: 1.5;
            word-break: break-word;
            white-space: pre-wrap;
        }

        .message-wrapper.bot .message-bubble {
            background-color: #FAF7F2;
            color: var(--coffee-dark);
            border-top-left-radius: 4px;
            border: 1px solid rgba(200, 125, 85, 0.1);
        }

        .message-wrapper.user .message-bubble {
            background-color: var(--coffee-primary);
            color: white;
            border-top-right-radius: 4px;
        }

        /* Панель статусів / Tool calling бейдж */
        .status-container {
            padding: 8px 25px;
            background: #fffdf9;
            border-top: 1px solid #f1f1ef;
            min-height: 36px;
        }

        .agent-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: #8c7b70;
            background: #F3E9E2;
            padding: 4px 12px;
            border-radius: 20px;
            font-style: italic;
            animation: pulseStatus 1.5s infinite;
        }

        @keyframes pulseStatus {
            0% { opacity: 0.7; }
            50% { opacity: 1; }
            100% { opacity: 0.7; }
        }

        .chat-input-area {
            padding: 20px 25px;
            background: #ffffff;
            border-top: 1px solid rgba(200, 125, 85, 0.15);
            display: flex;
            gap: 12px;
        }

        .chat-input-area input {
            flex: 1;
            padding: 12px 20px;
            border: 1px solid #dcd6cd;
            border-radius: 30px;
            outline: none;
            font-size: 0.95rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .chat-input-area input:focus {
            border-color: var(--coffee-primary);
            box-shadow: 0 0 0 3px rgba(200, 125, 85, 0.15);
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            padding: 0 24px;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ (єдина для всього проєкту) -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/shops">
                <span>☕</span> Zruchno Coffee News
            </a>

            <!-- Кнопка мобільного меню -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Елементи навігації -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center gap-2">
                    
                    <!-- Випадаюче меню для розділів та фіч -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle btn btn-light btn-sm px-3 border shadow-sm text-dark fw-medium rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill text-primary me-1"></i> Розділи проєкту
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-4">
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/shops"><i class="bi bi-house-door text-secondary"></i> Головна / Каталог</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/map"><i class="bi bi-map text-success"></i> Мапа та статистика</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/benchmark"><i class="bi bi-lightning-charge text-warning"></i> C10 Benchmark</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/dashboard"><i class="bi bi-palette text-info"></i> Спільна дошка</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/game"><i class="bi bi-controller text-danger"></i> Міні-гра (F6)</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/notes"><i class="bi bi-journal-text text-primary"></i> Notion Редактор</a></li>
                        </ul>
                    </li>

                    <!-- AI Бариста -->
                    <li class="nav-item">
                        <a href="/chat" class="btn btn-outline-dark btn-sm px-3 shadow-sm rounded-pill d-flex align-items-center gap-1 active">
                            <i class="bi bi-robot"></i> AI Бариста
                        </a>
                    </li>

                    <!-- БЛОК АВТЕНТИФІКАЦІЇ GOOGLE OAUTH2 -->
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary"></i> <span><%= user.name %></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4">
                                    <li><span class="dropdown-item-text small text-muted"><%= user.email %></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-semibold" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Вийти</a></li>
                                </ul>
                            </div>
                        <% } else { %>
                            <a href="/auth/google" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-google text-danger"></i> Увійти через Google
                            </a>
                        <% } %>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- ОСНОВНИЙ КОНТЕЙНЕР ЧАТУ -->
    <div class="container">
        <div class="chat-container">
            
            <!-- Хедєр чату -->
            <div class="chat-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white p-2 rounded-circle shadow-sm text-primary fs-5 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        🤖
                    </div>
                    <div>
                        <h5 class="fw-bold m-0">ШІ-Бариста ZruchnoCoffee</h5>
                        <span class="small text-muted">Онлайн • Доступ до бази кав'ярень та меню</span>
                    </div>
                </div>
                <a href="/shops" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> На головну
                </a>
            </div>

            <!-- Вікно повідомлень -->
            <div id="chat-messages" class="chat-messages">
                <!-- Привітне повідомлення від бота -->
                <div class="message-wrapper bot">
                    <div class="message-avatar">☕</div>
                    <div class="message-bubble">
                        Привіт! Я ваш віртуальний ШІ-бариста. Запитайте мене про кав'ярні Києва, пошук закладу за адресою або позиції в меню (наприклад, <i>«що є дешевше 120 грн»</i>), і я допоможу знайти найкраще!
                    </div>
                </div>
            </div>
            
            <!-- Динамічний статус агента (Tool Calling / Analysis) -->
            <div class="status-container d-flex align-items-center">
                <div id="agent-status-wrapper"></div>
            </div>
            
            <!-- Поле введення -->
            <div class="chat-input-area">
                <input type="text" id="user-input" class="form-control" placeholder="Запитайте про кав'ярню або меню (напр. какао до 100 грн)..." onkeydown="if(event.key === 'Enter') sendMessage();" />
                <button class="btn btn-coffee" onclick="sendMessage()">
                    <i class="bi bi-send-fill me-1"></i> Надіслати
                </button>
            </div>

        </div>
    </div>

    <script>
    async function sendMessage() {
        const input = document.getElementById('user-input');
        const messagesDiv = document.getElementById('chat-messages');
        const statusWrapper = document.getElementById('agent-status-wrapper');
        
        const text = input.value.trim();
        if (!text) return;

        // Додаємо повідомлення користувача
        messagesDiv.innerHTML += `
            <div class="message-wrapper user">
                <div class="message-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="message-bubble">${escapeHtml(text)}</div>
            </div>
        `;
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        // Створюємо унікальний блок для відповіді бота
        const agentMsgId = 'agent-msg-' + Date.now();
        messagesDiv.innerHTML += `
            <div class="message-wrapper bot">
                <div class="message-avatar">☕</div>
                <div class="message-bubble text-muted fst-italic" id="${agentMsgId}">Думаю над відповіддю...</div>
            </div>
        `;
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        try {
            const response = await fetch('/api/agent/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            const bubbleElement = document.getElementById(agentMsgId);

            let buffer = '';
            let isFirstChunk = true;

            while (true) {
                const { value, done } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n\n');
                
                buffer = lines.pop();

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        try {
                            const data = JSON.parse(line.replace('data: ', ''));

                            if (data.type === 'status') {
                                // Виводимо красивий бейдж статусу Tool Calling / аналізу
                                statusWrapper.innerHTML = `<div class="agent-status-badge"><i class="bi bi-cpu text-primary"></i> ${escapeHtml(data.content)}</div>`;
                            } else if (data.type === 'chunk') {
                                // Очищаємо статус, коли починається стрімінг тексту
                                statusWrapper.innerHTML = '';

                                if (isFirstChunk) {
                                    bubbleElement.classList.remove('text-muted', 'fst-italic');
                                    bubbleElement.textContent = ''; // прибираємо "Думаю над відповіддю..."
                                    isFirstChunk = false;
                                }

                                bubbleElement.textContent += data.content;
                                messagesDiv.scrollTop = messagesDiv.scrollHeight;
                            } else if (data.type === 'done') {
                                statusWrapper.innerHTML = '';
                            }
                        } catch (e) {
                            console.error('Помилка парсингу SSE:', e);
                        }
                    }
                }
            }
        } catch (err) {
            console.error(err);
            statusWrapper.innerHTML = '';
            const bubbleElement = document.getElementById(agentMsgId);
            if (bubbleElement) {
                bubbleElement.classList.remove('text-muted', 'fst-italic');
                bubbleElement.classList.add('text-danger');
                bubbleElement.textContent = 'Сталася помилка звʼязку з ШІ-агентом.';
            }
        }
    }

    // Допоміжна функція безпеки для уникнення XSS
    function escapeHtml(string) {
        return String(string)
            .replace(/&/g, '&')
            .replace(/</g, '<')
            .replace(/>/g, '>')
            .replace(/"/g, '"');
    }
    </script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>