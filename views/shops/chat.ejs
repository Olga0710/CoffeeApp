<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Бариста | Zruchno Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #FAF7F2; color: #2C221E; padding-top: 40px; }
        .chat-card { background: #FFFFFF; border: 1px solid rgba(200, 125, 85, 0.2); border-radius: 20px; box-shadow: 0 10px 30px rgba(44, 34, 30, 0.05); }
        .btn-coffee { background-color: #C87D55; color: white; border-radius: 30px; font-weight: 600; border: none; }
        .btn-coffee:hover { background-color: #B26B45; color: white; }
        
        /* Зберігає всі пробіли та форматування при стрімінгу SSE */
        .agent-text {
            white-space: pre-wrap;
            word-break: break-word;
        }
    </style>
</head>
<body>
    <div class="container" style="max-width: 600px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0">🤖 ШІ Асистент Бариста</h3>
            <a href="/shops" class="btn btn-outline-secondary btn-sm rounded-pill px-3">← Назад до каталогу</a>
        </div>

        <div class="chat-card p-4">
            <div id="chat-messages" style="height: 350px; overflow-y: auto; border: 1px solid #eee; padding: 15px; margin-bottom: 15px; background: #f9f9f9; border-radius: 12px;">
                <div class="text-muted small fst-italic mb-2">Привіт! Я ваш віртуальний бариста. Запитайте мене про кав'ярні Києва, меню або категорії, і я допоможу знайти найкраще місце.</div>
            </div>
            
            <div id="agent-status" class="small fst-italic text-muted mb-2" style="min-height: 20px;"></div>
            
            <div class="input-group">
                <input type="text" id="user-input" class="form-control rounded-start-pill px-3" placeholder="Запитайте про кав'ярні або меню..." onkeydown="if(event.key === 'Enter') sendMessage();" />
                <button class="btn btn-coffee rounded-end-pill px-4" onclick="sendMessage()">Надіслати</button>
            </div>
        </div>
    </div>

    <script>
    async function sendMessage() {
        const input = document.getElementById('user-input');
        const messagesDiv = document.getElementById('chat-messages');
        const statusDiv = document.getElementById('agent-status');
        
        const text = input.value.trim();
        if (!text) return;

        messagesDiv.innerHTML += `<div class="mb-2 text-end"><b>Ви:</b> <span class="bg-light p-2 rounded d-inline-block text-start">${text}</span></div>`;
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        const agentMsgId = 'agent-msg-' + Date.now();
        messagesDiv.innerHTML += `<div class="mb-2"><b>Бариста:</b> <span id="${agentMsgId}" class="agent-text text-secondary"></span></div>`;

        try {
            const response = await fetch('/api/agent/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            const spanElement = document.getElementById(agentMsgId);

            let buffer = '';

            while (true) {
                const { value, done } = await reader.read();
                if (done) break;

                // Накопичуємо залишкові пакети в буфер для надійної розпакування SSE
                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n\n');
                
                // Залишаємо недописаний шматок лінії в буфері
                buffer = lines.pop();

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        try {
                            const data = JSON.parse(line.replace('data: ', ''));

                            if (data.type === 'status') {
                                statusDiv.innerText = data.content;
                            } else if (data.type === 'chunk') {
                                statusDiv.innerText = '';
                                spanElement.classList.remove('text-secondary');
                                
                                // textContent замість innerText для збереження точних пробілів
                                spanElement.textContent += data.content;
                                messagesDiv.scrollTop = messagesDiv.scrollHeight;
                            } else if (data.type === 'done') {
                                statusDiv.innerText = '';
                            }
                        } catch (e) {
                            console.error('Помилка парсингу SSE:', e);
                        }
                    }
                }
            }
        } catch (err) {
            console.error(err);
            statusDiv.innerText = 'Помилка звʼязку з агентом.';
        }
    }
    </script>
</body>
</html>