<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Помилка доступу</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light text-center py-5">
    <div class="container mt-5" style="max-width: 500px;">
        <div class="card p-4 shadow-sm border-0 rounded-4">
            <h1 class="display-1">🔒</h1>
            <h3 class="fw-bold text-dark mt-3">Доступ обмежено</h3>
            <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'У вас немає доступу до цієї сторінки.' %></p>
            <a href="/shops" class="btn btn-dark rounded-pill mt-3">На головну</a>
        </div>
    </div>
</body>
</html>