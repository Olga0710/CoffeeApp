<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Редагування закладу | Travel-Журнал</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 40px 0;
        }

        .edit-container {
            background: var(--card-bg);
            border: 1px solid rgba(200, 125, 85, 0.15);
            border-radius: 28px;
            box-shadow: 0 20px 40px rgba(44, 34, 30, 0.06);
            overflow: hidden;
        }

        .preview-pane {
            background: #F3E9E2;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }

        .preview-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 16px;
            box-shadow: 0 10px 20px rgba(44, 34, 30, 0.1);
        }

        .form-pane {
            padding: 40px;
        }

        .form-control, .form-control:focus {
            background-color: #FAF7F2;
            border: 1px solid rgba(200, 125, 85, 0.2);
            border-radius: 12px;
            color: var(--coffee-dark);
            padding: 12px 16px;
        }

        .form-control:focus {
            border-color: var(--coffee-primary);
            box-shadow: 0 0 0 4px rgba(200, 125, 85, 0.15);
        }

        .form-label {
            font-weight: 600;
            color: var(--coffee-dark);
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            padding: 12px 24px;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }

        .btn-outline-custom {
            border: 1px solid rgba(44, 34, 30, 0.2);
            color: var(--coffee-dark);
            border-radius: 30px;
            font-weight: 600;
            padding: 12px 24px;
            background: transparent;
            transition: all 0.2s;
        }

        .btn-outline-custom:hover {
            background-color: rgba(44, 34, 30, 0.05);
            color: var(--coffee-dark);
        }
    </style>
</head>
<body>

    <div class="container" style="max-width: 1000px;">
        <div class="edit-container">
            <div class="row g-0">
                
                <!-- ЛІВА КОЛОНКА: ПРЕВ'Ю ТА АТМОСФЕРА -->
                <div class="col-lg-5 preview-pane">
                    <div>
                        <a href="/shops" class="text-decoration-none text-dark fw-bold small d-inline-flex align-items-center gap-2 mb-4">
                            <i class="bi bi-arrow-left"></i> Назад до каталогу
                        </a>
                        <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold shadow-sm mb-3">Режим редагування</span>
                        <h3 class="fw-bold mb-2"><%= shop.name %></h3>
                        <p class="text-muted small mb-4">Змінюйте параметри закладу — усі оновлення миттєво відобразяться на головній сторінці журналу.</p>
                    </div>

                    <div>
                        <% if (shop.image_url) { %>
                            <img src="<%= shop.image_url %>" alt="<%= shop.name %>" class="preview-image mb-3">
                        <% } else { %>
                            <div class="preview-image d-flex align-items-center justify-content-center bg-white text-muted">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        <% } %>
                        <p class="text-center text-muted small fst-italic mb-0">Поточне фото закладу</p>
                    </div>
                </div>

                <!-- ПРАВА КОЛОНКА: ФОРМА РЕДАГУВАННЯ -->
                <div class="col-lg-7 form-pane">
                    <h4 class="fw-bold mb-4">✏️ Дані кав'ярні</h4>

                    <form action="/shops/edit/<%= shop.id %>" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Назва закладу</label>
                            <input type="text" name="name" class="form-control" value="<%= shop.name %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Адреса</label>
                            <input type="text" name="address" class="form-control" value="<%= shop.address %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Години роботи</label>
                            <input type="text" name="opening_hours" class="form-control" value="<%= shop.opening_hours || '' %>" placeholder="Наприклад: щодня, з 10:00 до 23:00">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Опис закладу</label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Розкажіть про особливості..."><%= shop.description %></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Посилання на фото (Image URL)</label>
                            <input type="url" name="image_url" class="form-control" value="<%= shop.image_url %>" required>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-coffee flex-fill">Зберегти зміни</button>
                            <a href="/shops" class="btn btn-outline-custom">Скасувати</a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>