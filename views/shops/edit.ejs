<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Редагувати кав'ярню</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4" style="max-width: 600px;">
    <h1>✏️ Редагувати кав'ярню</h1>
    <form action="/shops/edit/<%= shop.id %>" method="POST" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Назва:</label>
            <input type="text" name="name" class="form-control" value="<%= shop.name %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Опис:</label>
            <textarea name="description" class="form-control" rows="3"><%= shop.description %></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Адреса:</label>
            <input type="text" name="address" class="form-control" value="<%= shop.address %>" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Пропозиції (Offerings):</label>
            <input type="text" name="offerings" class="form-control" value="<%= shop.offerings %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Посилання на фото (ImageUrl):</label>
            <input type="url" name="image_url" class="form-control" value="<%= shop.image_url %>">
        </div>
        <button type="submit" class="btn btn-success">Зберегти зміни</button>
        <a href="/shops" class="btn btn-secondary">Назад</a>
    </form>
</body>
</html>