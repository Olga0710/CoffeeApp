<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel-Журнал | Кав'ярні Києва</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --coffee-accent: #E8A87C;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            padding-top: 80px;
        }

        .navbar {
            background-color: var(--card-bg) !important;
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        .hero-journal {
            background: linear-gradient(180deg, rgba(44, 34, 30, 0.65) 0%, rgba(44, 34, 30, 0.85) 100%), 
                        url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb') center/cover no-repeat;
            color: white;
            padding: 90px 0;
            border-radius: 0 0 32px 32px;
            margin-bottom: 40px;
        }

        .intro-article-card {
            background: var(--card-bg);
            border: 1px solid rgba(200, 125, 85, 0.2);
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.03);
            position: relative;
        }

        .intro-article-card::before {
            content: "☕";
            position: absolute;
            top: -20px;
            left: 40px;
            background: var(--bg-cream);
            padding: 0 15px;
            font-size: 1.5rem;
        }

        .flip-card {
            background-color: transparent;
            perspective: 1000px;
            height: 100%;
            min-height: 520px;
        }

        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: left;
            transition: transform 0.6s;
            transform-style: preserve-3d;
            box-shadow: 0 15px 30px rgba(44, 34, 30, 0.08);
            border-radius: 20px;
        }

        .flip-card:hover .flip-card-inner {
            transform: rotateY(180deg);
        }

        .flip-card-front, .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 20px;
            background: var(--card-bg);
            border: 1px solid rgba(200, 125, 85, 0.15);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .flip-card-back {
            transform: rotateY(180deg);
            padding: 30px;
            justify-content: space-between;
        }

        .flip-card-back .description-box {
            max-height: 280px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--coffee-primary) #FAF7F2;
        }

        .flip-card-back .description-box::-webkit-scrollbar {
            width: 6px;
        }

        .flip-card-back .description-box::-webkit-scrollbar-track {
            background: #FAF7F2;
            border-radius: 10px;
        }

        .flip-card-back .description-box::-webkit-scrollbar-thumb {
            background: var(--coffee-primary);
            border-radius: 10px;
        }

        .shop-image-container {
            height: 220px;
            background-color: #F3E9E2;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--coffee-primary);
            font-size: 2.5rem;
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }

        .badge-coffee {
            background-color: #F3E9E2;
            color: var(--coffee-primary);
            font-weight: 600;
            border-radius: 30px;
            padding: 6px 14px;
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/shops">
                <span>☕</span> Zruchno Coffee News
            </a>

            <!-- Кнопка мобільного меню -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Елементи навігації -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center gap-2">
                    
                    <!-- Випадаюче меню для розділів та фіч -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle btn btn-light btn-sm px-3 border shadow-sm text-dark fw-medium rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill text-primary me-1"></i> Розділи проєкту
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-4">
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/map"><i class="bi bi-map text-success"></i> Мапа та статистика</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/benchmark"><i class="bi bi-lightning-charge text-warning"></i> C10 Benchmark</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/dashboard"><i class="bi bi-palette text-info"></i> Спільна дошка</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/game"><i class="bi bi-controller text-danger"></i> Міні-гра (F6)</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/notes"><i class="bi bi-journal-text text-primary"></i> Notion Редактор</a></li>
                        </ul>
                    </li>

                    <!-- AI Бариста -->
                    <li class="nav-item">
                        <a href="/chat" class="btn btn-outline-dark btn-sm px-3 shadow-sm rounded-pill d-flex align-items-center gap-1">
                            <i class="bi bi-robot"></i> AI Бариста
                        </a>
                    </li>

                    <!-- БЛОК АВТЕНТИФІКАЦІЇ GOOGLE OAUTH2 -->
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary"></i> <span><%= user.name %></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4">
                                    <li><span class="dropdown-item-text small text-muted"><%= user.email %></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-semibold" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Вийти</a></li>
                                </ul>
                            </div>
                        <% } else { %>
                            <a href="/auth/google" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-google text-danger"></i> Увійти через Google
                            </a>
                        <% } %>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- HERO ЖУРНАЛУ -->
    <header class="hero-journal text-center">
        <div class="container" style="max-width: 800px;">
            <span class="badge badge-coffee mb-3">Travel-Журнал • Київ</span>
            <h1 class="display-5 fw-bold mb-3">Кава з родзинкою: найкращі кав’ярні Києва</h1>
            <p class="lead text-light opacity-85 mb-0 fs-6">
                Керуйте каталогом затишних закладів столиці, редагуйте інформацію та додавайте нові унікальні місця через єдину базу даних.
            </p>
        </div>
    </header>

    <main class="container mb-5">
        
        <!-- АТМОСФЕРНИЙ ВСТУПНИЙ БЛОК -->
        <section class="mb-5">
            <div class="intro-article-card text-secondary">
                <p class="fs-5 fw-medium text-dark mb-3" style="line-height: 1.6;">
                    Ненав’язлива музика, філіжанка запашної кави та апетитний шматок смачного торта – що може бути краще в холодний осінній день?
                </p>
                <p class="mb-0 fs-6" style="line-height: 1.7;">
                    У Києві є так багато хороших закладів, де можна приємно провести час як у компанії друзів, так і в гордій самоті, попиваючи улюблений напій і читаючи цікаву книгу. Ми постаралися зібрати найрізноманітніші, але однаково затишні заклади столиці зі своєю родзинкою, де завжди запропонують смачну каву і свіжі десерти. Про те, де приємно провести осінні вечори, читайте в нашому матеріалі.
                </p>
            </div>
        </section>

        <!-- СПИСОК УСІХ КАВ'ЯРЕНЬ З БАЗИ ДАНИХ -->
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold m-0">📍 Каталог кав'ярень та закладів</h3>
                <a href="/shops/create" class="btn btn-coffee btn-sm">Додати новий заклад</a>
            </div>

            <% if (typeof shops === 'undefined' || shops.length === 0) { %>
                <div class="card p-5 text-center shop-card border-0 shadow-sm" style="border-radius: 20px;">
                    <i class="bi bi-cup-hot text-muted fs-1 mb-3"></i>
                    <h4 class="fw-bold">У системі поки немає кав'ярень.</h4>
                    <p class="text-muted mb-3">Додайте свій перший заклад через форму!</p>
                    <a href="/shops/create" class="btn btn-coffee mx-auto px-4">Створити кав'ярню</a>
                </div>
            <% } else { %>
                <div class="row g-4">
                    <% shops.forEach(shop => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="flip-card">
                                <div class="flip-card-inner">
                                    
                                    <!-- ЛИЦЬОВА СТОРОНА КАРТКИ -->
                                    <div class="flip-card-front">
                                        <% if (shop.image_url) { %>
                                            <img src="<%= shop.image_url %>" class="card-img-top" alt="<%= shop.name %>" style="height: 220px; object-fit: cover;">
                                        <% } else { %>
                                            <div class="shop-image-container">
                                                <i class="bi bi-cup-hot"></i>
                                            </div>
                                        <% } %>
                                        <div class="card-body d-flex flex-column p-4 flex-grow-1">
                                            <h4 class="card-title fw-bold mb-2"><%= shop.name %></h4>
                                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> <%= shop.address %></p>
                                            <% if (shop.opening_hours) { %>
                                                <p class="text-muted small mb-3"><i class="bi bi-clock-fill text-primary"></i> <%= shop.opening_hours %></p>
                                            <% } %>
                                            <div class="mt-auto text-center text-muted small fst-italic pt-3 border-top">
                                                🔄 Наведіть курсор, щоб прочитати опис
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ЗВОРОТНА СТОРОНА КАРТКИ -->
                                    <div class="flip-card-back">
                                        <div>
                                            <h4 class="fw-bold mb-3 pb-2 border-bottom"><%= shop.name %></h4>
                                            <% if (shop.description) { %>
                                                <div class="description-box pe-2">
                                                    <p class="text-secondary fs-6 mb-0" style="line-height: 1.7;"><%= shop.description %></p>
                                                </div>
                                            <% } else { %>
                                                <p class="text-muted small fst-italic">Опис відсутній для цього закладу...</p>
                                            <% } %>
                                        </div>
                                        
                                        <!-- Кнопки управління та меню -->
                                        <div class="d-flex align-items-center gap-2 pt-3 border-top">
                                            <a href="/shops/<%= shop.id %>/menu" class="btn btn-coffee btn-sm flex-fill">Меню закладу</a>
                                            <a href="/shops/edit/<%= shop.id %>" class="btn btn-outline-secondary btn-sm px-3" title="Редагувати">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="/shops/delete/<%= shop.id %>" method="POST" class="m-0" onsubmit="return confirm('Ви впевнені, що хочете видалити кав’ярню «<%= shop.name %>»?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-3" title="Видалити">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>

    </main>

    <!-- ФУТЕР -->
    <footer class="bg-white text-center py-4 border-top mt-5">
        <div class="container">
            <p class="mb-0 text-muted small">© 2026 Zruchno Coffee News. Всі права захищені.</p>
        </div>
    </footer>

    <!-- КЛІЄНТСЬКИЙ СКРИПТ WEBSOCKET (Вимога C10) -->
    <script>
        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${wsProtocol}//${window.location.host}`);

        ws.onopen = () => {
            console.log('🔗 WebSocket з’єднання з сервером успішно встановлено.');
        };

        ws.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                console.log('📥 Отримано подію через WebSocket:', data);

                if (data.message) {
                    showNotification(data.message);
                }
            } catch (e) {
                console.error('Помилка обробки повідомлення WebSocket:', e);
            }
        };

        ws.onclose = () => {
            console.log('❌ WebSocket з’єднання закрито.');
        };

        function showNotification(text) {
            let container = document.getElementById('ws-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'ws-toast-container';
                container.style.cssText = 'position: fixed; bottom: 25px; right: 25px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.style.cssText = 'background: #2C221E; color: #FAF7F2; padding: 12px 20px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.2); font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 10px;';
            toast.innerHTML = `<i class="bi bi-bell-fill text-warning"></i> <span>${text}</span>`;
            
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.5s ease';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }
    </script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>