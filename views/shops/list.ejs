<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Список кав'ярень</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1>☕ Карта затишних кав'ярень (MVC)</h1>
    <a href="/shops/create" class="btn btn-success mb-3">+ Додати нову кав'ярню</a>

    <div class="row">
        <% shops.forEach(shop => { %>
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <% if (shop.image_url) { %>
                        <img src="<%= shop.image_url %>" class="card-img-top" alt="Фото кав'ярні" style="height: 200px; object-fit: cover;">
                    <% } %>
                    <div class="card-body">
                        <h5 class="card-title"><%= shop.name %></h5>
                        <p class="card-text"><strong>Адреса:</strong> <%= shop.address %></p>
                        <% if (shop.description) { %>
                            <p class="card-text text-muted"><%= shop.description %></p>
                        <% } %>
                        <% if (shop.offerings) { %>
                            <p class="card-text"><small><strong>Особливості:</strong> <%= shop.offerings %></small></p>
                        <% } %>
                        
                        <!-- Кнопка перегляду меню -->
                        <div class="mb-3">
                            <a href="/shops/<%= shop.id %>/menu" class="btn btn-outline-primary btn-sm w-100">📋 Переглянути меню</a>
                        </div>

                        <!-- Блок кнопок Редагувати та Видалити -->
                        <div class="d-flex gap-2">
                            <a href="/shops/edit/<%= shop.id %>" class="btn btn-warning btn-sm flex-fill">Редагувати</a>
                            <form action="/shops/delete/<%= shop.id %>" method="POST" style="display:inline;" class="flex-fill">
                                <button type="submit" class="btn btn-danger btn-sm w-100">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>