<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мапа кав'ярень — Zruchno Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js CDN (Вимога F1) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            padding-top: 90px;
            padding-bottom: 40px;
        }

        .navbar {
            background-color: var(--card-bg) !important;
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        #map {
            height: 60vh;
            width: 100%;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.05);
            border: 1px solid rgba(200, 125, 85, 0.15);
        }

        /* Покращені стилі для спливаючого вікна Leaflet */
        .leaflet-popup-content-wrapper {
            border-radius: 12px;
            padding: 5px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .leaflet-popup-content {
            min-width: 260px !important;
            max-width: 300px !important;
            text-align: left;
            font-size: 14px;
        }

        .shop-address {
            word-wrap: break-word;
            overflow-wrap: break-word;
            white-space: normal;
        }

        .card-custom {
            background: var(--card-bg);
            border: 1px solid rgba(200, 125, 85, 0.15);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.03);
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ (єдина для всього проєкту) -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/shops">
                <span>☕</span> Zruchno Coffee News
            </a>

            <!-- Кнопка мобільного меню -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Елементи навігації -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center gap-2">
                    
                    <!-- Випадаюче меню для розділів та фіч -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle btn btn-light btn-sm px-3 border shadow-sm text-dark fw-medium rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill text-primary me-1"></i> Розділи проєкту
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-4">
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/shops"><i class="bi bi-house-door text-secondary"></i> Головна / Каталог</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/map"><i class="bi bi-map text-success"></i> Мапа та статистика</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/benchmark"><i class="bi bi-lightning-charge text-warning"></i> C10 Benchmark</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/dashboard"><i class="bi bi-palette text-info"></i> Спільна дошка</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/game"><i class="bi bi-controller text-danger"></i> Міні-гра (F6)</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/notes"><i class="bi bi-journal-text text-primary"></i> Notion Редактор</a></li>
                        </ul>
                    </li>

                    <!-- AI Бариста -->
                    <li class="nav-item">
                        <a href="/chat" class="btn btn-outline-dark btn-sm px-3 shadow-sm rounded-pill d-flex align-items-center gap-1">
                            <i class="bi bi-robot"></i> AI Бариста
                        </a>
                    </li>

                    <!-- БЛОК АВТЕНТИФІКАЦІЇ GOOGLE OAUTH2 -->
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary"></i> <span><%= user.name %></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4">
                                    <li><span class="dropdown-item-text small text-muted"><%= user.email %></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-semibold" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Вийти</a></li>
                                </ul>
                            </div>
                        <% } else { %>
                            <a href="/auth/google" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-google text-danger"></i> Увійти через Google
                            </a>
                        <% } %>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="mb-4">
            <h2 class="fw-bold mb-2">🗺️ Інтерактивна мапа кав'ярень</h2>
            <p class="text-muted">Усі заклади мережі на єдиній мапі з можливістю миттєвої фільтрації, комбінованою аналітикою та відеотрансляцією з бару.</p>
        </div>

        <!-- Панель фільтрації в реальному часі -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-0 shadow-none py-2" placeholder="Пошук за назвою або адресою...">
                </div>
            </div>
        </div>

        <!-- Контейнер для мапи -->
        <div id="map" class="mb-5"></div>

        <!-- Блок візуалізації комбінованої статистики -->
        <div class="row">
            <div class="col-md-12">
                <div class="card card-custom p-4">
                    <h5 class="mb-4 fw-bold text-center">📊 Аналітика меню: асортимент та середня вартість</h5>
                    <div style="position: relative; height: 300px; width: 100%;">
                        <canvas id="shopsStatsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="/shops" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm"><i class="bi bi-arrow-left me-1"></i> Назад до каталогу кав'ярень</a>
        </div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Ініціалізація мапи (центр на Києві)
        const map = L.map('map').setView([50.4501, 30.5234], 13);

        // Підключення шару OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        let markersLayer = L.layerGroup().addTo(map);
        let allShops = [];
        let statsChart = null;

        // Змінні для глобального керування WebRTC потоком камери
        let localStream = null;

        // Функція для керування WebRTC камерою безпосередньо з попапу мапи
        async function toggleShopWebcam() {
            const videoElement = document.getElementById('shopWebcamVideo');
            const container = document.getElementById('shopWebcamContainer');
            const btn = document.getElementById('webcamBtn');

            if (!localStream) {
                try {
                    // Виклик низькорівневого WebRTC API для доступу до камери (Вимога С15)
                    localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    if (videoElement) videoElement.srcObject = localStream;
                    if (container) container.classList.remove('d-none');
                    if (btn) {
                        btn.innerText = 'Вимкнути камеру бару';
                        btn.classList.replace('btn-dark', 'btn-danger');
                    }
                } catch (err) {
                    alert('Не вдалося отримати доступ до веб-камери: ' + err.message);
                }
            } else {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
                if (videoElement) videoElement.srcObject = null;
                if (container) container.classList.add('d-none');
                if (btn) {
                    btn.innerText = '🔴 Жива камера баристу';
                    btn.classList.replace('btn-danger', 'btn-dark');
                }
            }
        }

        // Зупинка камери при закритті попапу, щоб ресурси не зависали
        map.on('popupclose', () => {
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
            }
        });

        // Функція для відображення маркерів на мапі з інтегрованим WebRTC
        function displayMarkers(shops) {
            markersLayer.clearLayers();

            shops.forEach(shop => {
                if (shop.latitude && shop.longitude) {
                    const marker = L.marker([shop.latitude, shop.longitude]);
                    
                    marker.bindPopup(`
                        <div style="padding: 4px;">
                            <h6 class="mb-1" style="font-weight: bold; color: #333;">${shop.name}</h6>
                            <p class="mb-2 text-muted shop-address" style="font-size: 13px;">📍 ${shop.address}</p>
                            <a href="/shops/${shop.id}/menu" class="btn btn-sm btn-coffee w-100 mb-2">Переглянути меню</a>
                            
                            <!-- ВИМОГА С15: WebRTC Live Stream з бару -->
                            <div class="border-top pt-2 mt-1 text-center">
                                <button class="btn btn-sm btn-dark w-100 rounded-pill" id="webcamBtn" onclick="toggleShopWebcam()">🔴 Жива камера баристу</button>
                                <div id="shopWebcamContainer" class="mt-2 d-none">
                                    <video id="shopWebcamVideo" autoplay playsinline class="w-100 shadow-sm rounded-2" style="max-height: 150px; object-fit: cover; background: #000;"></video>
                                </div>
                            </div>
                        </div>
                    `);

                    markersLayer.addLayer(marker);
                }
            });
        }

        // Функція для побудови комбінованого графіка (Mixed Chart)
        async function renderMixedChart(shops) {
            const ctx = document.getElementById('shopsStatsChart').getContext('2d');
            const labels = [];
            const menuCounts = [];
            const avgPrices = [];

            for (const shop of shops) {
                try {
                    const res = await fetch(`/api/shops/${shop.id}/menu`);
                    const menuResponse = await res.json();
                    
                    const menuItems = Array.isArray(menuResponse) 
                        ? menuResponse 
                        : (menuResponse.data || []);

                    labels.push(shop.name);
                    menuCounts.push(menuItems.length);

                    if (menuItems.length > 0) {
                        const totalPrice = menuItems.reduce((sum, item) => sum + Number(item.price || 0), 0);
                        avgPrices.push((totalPrice / menuItems.length).toFixed(2));
                    } else {
                        avgPrices.push(0);
                    }
                } catch (e) {
                    labels.push(shop.name);
                    menuCounts.push(0);
                    avgPrices.push(0);
                }
            }

            if (statsChart) {
                statsChart.destroy();
            }

            statsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Кількість позицій у меню',
                            data: menuCounts,
                            backgroundColor: 'rgba(200, 125, 85, 0.6)',
                            borderColor: 'rgba(200, 125, 85, 1)',
                            borderWidth: 1,
                            borderRadius: 6,
                            yAxisID: 'y'
                        },
                        {
                            type: 'line',
                            label: 'Середня ціна (грн)',
                            data: avgPrices,
                            borderColor: 'rgba(44, 34, 30, 1)',
                            backgroundColor: 'rgba(44, 34, 30, 0.1)',
                            borderWidth: 3,
                            fill: false,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Кількість позицій'
                            },
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Ціна (₴)'
                            },
                            beginAtZero: true,
                            grid: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                callback: function(value) {
                                    return value + ' ₴';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Захищене завантаження даних кав'ярень через API
        fetch('/api/shops')
            .then(res => res.json())
            .then(response => {
                allShops = Array.isArray(response) ? response : (response.data || []);
                displayMarkers(allShops);
                if (allShops.length > 0) {
                    renderMixedChart(allShops);
                }
            })
            .catch(err => console.error('Помилка завантаження кав\'ярень:', err));

        document.getElementById('searchInput').addEventListener('input', (e) => {
            const searchText = e.target.value.toLowerCase();
            const filteredShops = allShops.filter(shop => 
                shop.name.toLowerCase().includes(searchText) || 
                shop.address.toLowerCase().includes(searchText)
            );
            displayMarkers(filteredShops);
        });
    </script>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>