<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zruchno Coffee - Спільна дошка для схем</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            margin: 0; 
            padding-top: 90px;
            padding-bottom: 40px;
            text-align: center; 
        }

        .navbar {
            background-color: var(--card-bg) !important;
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }

        .dashboard-container {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.05);
            border: 1px solid rgba(200, 125, 85, 0.15);
        }

        canvas { 
            border: 2px solid #e8a87c; 
            background: #fff; 
            cursor: crosshair; 
            border-radius: 12px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
            max-width: 100%;
            height: auto;
        }

        .controls { 
            margin-top: 20px; 
        }

        button.clear-btn { 
            padding: 9px 24px; 
            background: #dc3545; 
            color: #fff; 
            border: none; 
            border-radius: 30px; 
            cursor: pointer; 
            font-weight: 600;
            transition: background 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
        }

        button.clear-btn:hover {
            background: #bb2d3b;
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ (єдина для всього проєкту) -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/shops">
                <span>☕</span> Zruchno Coffee News
            </a>

            <!-- Кнопка мобільного меню -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Елементи навігації -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center gap-2">
                    
                    <!-- Випадаюче меню для розділів та фіч -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle btn btn-light btn-sm px-3 border shadow-sm text-dark fw-medium rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill text-primary me-1"></i> Розділи проєкту
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-4">
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/shops"><i class="bi bi-house-door text-secondary"></i> Головна / Каталог</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/map"><i class="bi bi-map text-success"></i> Мапа та статистика</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/benchmark"><i class="bi bi-lightning-charge text-warning"></i> C10 Benchmark</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/dashboard"><i class="bi bi-palette text-info"></i> Спільна дошка</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/game"><i class="bi bi-controller text-danger"></i> Міні-гра (F6)</a></li>
                            <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/notes"><i class="bi bi-journal-text text-primary"></i> Notion Редактор</a></li>
                        </ul>
                    </li>

                    <!-- AI Бариста -->
                    <li class="nav-item">
                        <a href="/chat" class="btn btn-outline-dark btn-sm px-3 shadow-sm rounded-pill d-flex align-items-center gap-1">
                            <i class="bi bi-robot"></i> AI Бариста
                        </a>
                    </li>

                    <!-- БЛОК АВТЕНТИФІКАЦІЇ GOOGLE OAUTH2 -->
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary"></i> <span><%= user.name %></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4">
                                    <li><span class="dropdown-item-text small text-muted"><%= user.email %></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-semibold" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Вийти</a></li>
                                </ul>
                            </div>
                        <% } else { %>
                            <a href="/auth/google" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-google text-danger"></i> Увійти через Google
                            </a>
                        <% } %>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <h1 class="h3 fw-bold mb-2">🎨 Спільна дошка для схем</h1>
        <p class="text-muted mb-4">Малюйте тут, і зміни миттєво з'являться на екранах інших учасників у реальному часі!</p>
        
        <canvas id="board" width="800" height="450"></canvas>
        
        <div class="controls">
            <button id="clearBtn" class="clear-btn"><i class="bi bi-trash me-1"></i> Очистити дошку</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('board');
        const ctx = canvas.getContext('2d');
        const clearBtn = document.getElementById('clearBtn');

        // Підключаємося до WebSocket на тому ж хості
        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${wsProtocol}//${window.location.host}`);

        let drawing = false;
        let lastX = 0, lastY = 0;

        canvas.addEventListener('mousedown', (e) => {
            drawing = true;
            const rect = canvas.getBoundingClientRect();
            lastX = e.clientX - rect.left;
            lastY = e.clientY - rect.top;
        });

        canvas.addEventListener('mousemove', (e) => {
            if (!drawing) return;
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Малюємо локально
            drawLine(lastX, lastY, x, y, '#C87D55', 4);

            // Надсилаємо дані на сервер
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'DRAW', x0: lastX, y0: lastY, x1: x, y1: y }));
            }

            lastX = x;
            lastY = y;
        });

        window.addEventListener('mouseup', () => { drawing = false; });

        function drawLine(x0, y0, x1, y1, color, width) {
            ctx.beginPath();
            ctx.moveTo(x0, y0);
            ctx.lineTo(x1, y1);
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.lineCap = 'round';
            ctx.stroke();
            ctx.closePath();
        }

        // Отримуємо події від інших користувачів
        ws.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'DRAW') {
                    drawLine(data.x0, data.y0, data.x1, data.y1, '#C87D55', 4);
                } else if (data.type === 'CLEAR') {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            } catch (e) {
                console.error("Помилка обробки повідомлення дошки:", e);
            }
        };

        clearBtn.addEventListener('click', () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'CLEAR' }));
            }
        });
    </script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>