<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zruchno Coffee - Shared Dashboard (C18)</title>
    <!-- Bootstrap 5 CSS для красивої навігації -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --coffee-dark: #2C221E;
            --coffee-primary: #C87D55;
            --card-bg: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-cream);
            color: var(--coffee-dark);
            margin: 0; 
            padding-top: 90px;
            padding-bottom: 40px;
            text-align: center; 
        }

        .navbar {
            background-color: var(--card-bg) !important;
            box-shadow: 0 4px 20px rgba(44, 34, 30, 0.05);
        }

        .btn-coffee {
            background-color: var(--coffee-primary);
            color: white;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            transition: background 0.2s;
        }

        .btn-coffee:hover {
            background-color: #B26B45;
            color: white;
        }

        .dashboard-container {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(44, 34, 30, 0.05);
            border: 1px solid rgba(200, 125, 85, 0.15);
        }

        canvas { 
            border: 2px solid #e8a87c; 
            background: #fff; 
            cursor: crosshair; 
            border-radius: 10px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
            max-width: 100%;
            height: auto;
        }

        .controls { 
            margin-top: 20px; 
        }

        button { 
            padding: 8px 20px; 
            background: #dc3545; 
            color: #fff; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-weight: 600;
            transition: background 0.2s;
        }

        button:hover {
            background: #bb2d3b;
        }
    </style>
</head>
<body>

    <!-- НАВІГАЦІЯ (як на всіх інших сторінках) -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark" href="/shops">
                ☕ Zruchno Coffee News
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/shops" class="btn btn-outline-dark btn-sm px-3 shadow-sm">🏠 Головна</a>
                <a href="/notes" class="btn btn-primary btn-sm px-3 shadow-sm">📝 Notion Редактор</a>
                <a href="/map" class="btn btn-success btn-sm px-3 shadow-sm">📊 Мапа та статистика</a>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <h1 class="h3 fw-bold mb-2">☕ Спільна дошка для схем (C18)</h1>
        <p class="text-muted mb-4">Малюйте тут, і зміни миттєво з'являться на екранах інших учасників!</p>
        
        <canvas id="board" width="800" height="450"></canvas>
        
        <div class="controls">
            <button id="clearBtn">Очистити дошку</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('board');
        const ctx = canvas.getContext('2d');
        const clearBtn = document.getElementById('clearBtn');

        // Підключаємося до WebSocket на тому ж хості
        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const ws = new WebSocket(`${wsProtocol}//${window.location.host}`);

        let drawing = false;
        let lastX = 0, lastY = 0;

        canvas.addEventListener('mousedown', (e) => {
            drawing = true;
            const rect = canvas.getBoundingClientRect();
            lastX = e.clientX - rect.left;
            lastY = e.clientY - rect.top;
        });

        canvas.addEventListener('mousemove', (e) => {
            if (!drawing) return;
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Малюємо локально
            drawLine(lastX, lastY, x, y, '#C87D55', 4);

            // Надсилаємо дані на сервер
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'DRAW', x0: lastX, y0: lastY, x1: x, y1: y }));
            }

            lastX = x;
            lastY = y;
        });

        window.addEventListener('mouseup', () => { drawing = false; });

        function drawLine(x0, y0, x1, y1, color, width) {
            ctx.beginPath();
            ctx.moveTo(x0, y0);
            ctx.lineTo(x1, y1);
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.lineCap = 'round';
            ctx.stroke();
            ctx.closePath();
        }

        // Отримуємо події від інших користувачів
        ws.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'DRAW') {
                    drawLine(data.x0, data.y0, data.x1, data.y1, '#C87D55', 4);
                } else if (data.type === 'CLEAR') {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            } catch (e) {
                console.error("Помилка обробки повідомлення дошки:", e);
            }
        };

        clearBtn.addEventListener('click', () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'CLEAR' }));
            }
        });
    </script>
</body>
</html>